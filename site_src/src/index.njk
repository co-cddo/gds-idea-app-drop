---
homepage: true
layout: page
title: Drop us a file
description: "Send files securely to the GDS IDEA Unit."
---

{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/button/macro.njk" import govukButton %}

<form id="upload-form" novalidate>
  {{ govukFileUpload({
    id: "file-upload",
    name: "file-upload",
    multiple: true,
    javascript: true,
    label: {
      text: "Upload one or more files"
    },
    hint: {
      text: "Each file can be up to 5GB. You can add more files by dropping or choosing them again before uploading."
    }
  }) }}

  <dl class="govuk-summary-list" id="pending-files" hidden></dl>

  {{ govukButton({
    text: "Upload",
    type: "submit",
    id: "upload-button"
  }) }}
</form>

<ul class="govuk-list" id="upload-status" aria-live="polite"></ul>

<script>
  // Personalises the welcome message with the signed-in user's first name
  // once known. The static version above (no "Welcome, X" prefix) is the
  // fallback shown before this runs (and for no-JS/search engines), so the
  // page reads sensibly either way.
  fetch('/.auth/user')
    .then((response) => (response.ok ? response.json() : null))
    .then((user) => {
      if (!user) {
        return;
      }

      const firstName = user.given_name || (user.name || '').split(' ')[0];
      if (!firstName) {
        return;
      }

      const lead = document.querySelector('.app-document-header .govuk-body-l');
      if (lead) {
        lead.textContent = `Welcome, ${firstName}.`;
      }
    })
    .catch(() => {});
</script>

<script type="module" src="/assets/upload.js"></script>
